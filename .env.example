# Documentation only: export variables or use your host's secret manager.
# The application does NOT automatically load .env files. Never commit real keys.

# LOCAL DEVELOPMENT (python app.py)
OES_CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# OES_DEV_DEBUG=true
# HOST=127.0.0.1
# PORT=5000

# PRODUCTION (gunicorn -c gunicorn.conf.py wsgi:app)
# Replace the local OES_CHAT_PROVIDER value above with openai_compatible.
# OES_CHAT_PROVIDER=openai_compatible
# OES_AI_BASE_URL=https://YOUR_PROVIDER_API_ROOT/v1
# OES_AI_API_KEY=YOUR_SERVER_SIDE_KEY
# OES_AI_MODEL=YOUR_SERVER_SIDE_MODEL
# HOST=0.0.0.0
# PORT=8000
# Default 0: ignore forwarded client IP/scheme. Set only for a verified proxy topology.
# OES_TRUSTED_PROXY_HOPS=0

# SERVER-AUTHORITATIVE KILL SWITCHES (true or false; malformed values fail closed)
OES_EYEBALL_ENABLED=true
OES_AI_CHAT_ENABLED=true
OES_PROACTIVE_ENABLED=true

# PER-PROCESS BETA LIMITS (positive integers; restart to change)
OES_API_RATE_LIMIT=60
OES_CHAT_RATE_LIMIT=12
OES_PROACTIVE_RATE_LIMIT=3
OES_AI_MAX_CONCURRENCY=2
# API and chat limits are per client per minute.
# Proactive limit is per client per 10 minutes, additionally charged to chat quota.
# An additional fixed process-wide limit permits 30 generation requests per minute.
